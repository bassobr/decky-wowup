{
  "name": "wow-addons",
  "version": "0.1.0",
  "description": "Decky plugin: update World of Warcraft addons from Game Mode via a headless WowUp-CF",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "node scripts/gen-version.mjs && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassobr/decky-wowup.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steamos",
    "world-of-warcraft",
    "wow",
    "addons",
    "wowup",
    "curseforge"
  ],
  "author": "bassobr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bassobr/decky-wowup/issues"
  },
  "homepage": "https://github.com/bassobr/decky-wowup#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
